let number = 153
var temp = number
var reverse = 0
while temp > 0 {
reverse = reverse * 10 + temp % 10
temp /= 10
}
if number == reverse {
print("Palindrome")
} else {
print("Not Palindrome")
}
let digits = String(number).count
temp = number
var sum = 0
while temp > 0 {
let digit = temp % 10
var power = 1
for _ in 1...digits {
    power *= digit
}
sum += power
temp /= 10
}
if sum == number {
print("Armstrong Number")
} else {
print("Not Armstrong Number")
}
