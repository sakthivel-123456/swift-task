let prices: [String: Double] = [
    "Apple": 20.0,
    "Milk": 30.0,
    "Bread": 40.0,
    "Rice": 60.0
]
let cart = ["Apple", "Milk", "Bread"]
var total: Double = 0
print("Shopping Cart:")
for item in cart {
    if let price = prices[item] {
        print("\(item): Rs. \(price)")
        total += price
    } else {
        print("\(item): Item not found")
    }
}
print("Total Bill: Rs. \(total)")
