struct Student {
var name: String
var marks: Int
init?(name: String, marks: Int) {
    if marks < 0 || marks > 100 {
        return nil
    }
    self.name = name
    self.marks = marks
}
}
if let s1 = Student(name: "Arun", marks: 85) {
print(s1.name, s1.marks)
} else {
print("Invalid marks")
}
if let s2 = Student(name: "Bala", marks: 120) {
print(s2.name, s2.marks)
} else {
print("Invalid marks")
}
