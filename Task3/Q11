struct Student {
var name: String
}
class Person {
var name: String
init(name: String) {
    self.name = name
}
}
var s1 = Student(name: "Arun")
var s2 = s1
s2.name = "Bala"
print("Struct original:", s1.name)
print("Struct copy:", s2.name)
let p1 = Person(name: "Arun")
let p2 = p1
p2.name = "Bala"
print("Class original:", p1.name)
print("Class copy:", p2.name)
