init(brand: String, speed: Int) {
self.brand = brand
self.speed = speed
}
func accelerate() {
    speed += 20
    print("Speed:", speed)
}
func brake() {
    speed = max(0, speed - 10)
    print("Speed:", speed)
}
}
let car = Car(brand: "Toyota", speed: 40)
print("Brand:", car.brand)
car.accelerate()
car.brake()
