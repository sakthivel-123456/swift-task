class Book {
var title: String
var author: String
init(title: String, author: String) {
    self.title = title
    self.author = author
}
}
class Library {
var books: [Book] = []

func addBook(_ book: Book) {
    books.append(book)
    print("Book added")
}
func removeBook(title: String) {
    if let index = books.firstIndex(where: { $0.title == title }) {
        books.remove(at: index)
        print("Book removed")
    } else {
        print("Book not found")
    }
}
func searchBook(title: String) {
    if let book = books.first(where: { $0.title == title }) {
        print("Found: \(book.title) by \(book.author)")
    } else {
        print("Book not found")
    }
}
func listBooks() {
    for book in books {
        print("\(book.title) - \(book.author)")
    }
}
}
let library = Library()
library.addBook(Book(title: "Swift Basics", author: "Arun"))
library.addBook(Book(title: "Java Basics", author: "Bala"))
library.listBooks()
library.searchBook(title: "Java Basics")
library.removeBook(title: "Swift Basics")
print("Books after removal:")
library.listBooks()
